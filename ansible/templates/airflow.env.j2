# SequentialExecutor (and LocalExecutor) run each task by spawning a
# subprocess that calls the bare `airflow tasks run ...` command -- it
# relies on PATH to find that binary. Without this, the scheduler starts
# fine (its own ExecStart uses a full path) but crashes the moment it
# actually tries to execute a queued task, since the inner subprocess call
# can't resolve 'airflow' via systemd's default PATH. That crash isn't
# handled gracefully -- it takes the whole scheduler process down and
# systemd just restarts it into the same failure, looping indefinitely.
PATH={{ airflow_home }}/venv/bin:/usr/bin:/bin
AIRFLOW_HOME={{ airflow_home }}
AIRFLOW__CORE__EXECUTOR=SequentialExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=sqlite:///{{ airflow_home }}/airflow.db
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_FOLDER={{ airflow_home }}/dags
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=False
AIRFLOW__CORE__DEFAULT_TIMEZONE=utc
# Required for the REST API to accept Basic Auth -- without this, Lambda's
# authenticated call to POST /api/v1/dags/.../dagRuns is rejected
# regardless of whether the username/password are correct.
AIRFLOW__API__AUTH_BACKENDS=airflow.api.auth.backend.basic_auth
